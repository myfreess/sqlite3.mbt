supported_targets = "native+wasm"

import {
  "moonbitlang/async",
  "moonbitlang/async/pipe",
  "moonbitlang/async/types",
}

options(
  "native-stub": [ "stub.c", "executor.c", "step_job.c", "sqlite3.c" ],
  targets: {
    "ffi.mbt": [ "native", "wasm" ],
    "ffi_native.mbt": [ "native" ],
    "ffi_wasm.mbt": [ "wasm" ],
  },
)
