import {
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/lexbuf",
  "moonbit-community/sqlite3/internal/ffi",
}

import {
  "moonbitlang/core/test",
} for "test"

// Keep derived traits as traits only; explicit extensions would add method-form
// APIs such as `ErrorCode::equal` to the generated package interface.

warnings = "-79"

supported_targets = "native+wasm"
